<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/root_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp">

        <!-- ===== 标题 ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textAppearance="?attr/textAppearanceHeadlineMedium"
            android:textColor="?attr/colorOnSurface" />

        <!-- ===== 当前挂载方式（状态卡，accent 容器色） ===== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="?attr/colorPrimaryContainer"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_check_circle"
                    app:tint="?attr/colorOnPrimaryContainer" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="当前挂载方式"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnPrimaryContainer" />

                    <TextView
                        android:id="@+id/tv_status_detail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnPrimaryContainer"
                        android:alpha="0.85"
                        android:text="—" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_mode_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:text="WEB"
                    android:textColor="?attr/colorOnPrimary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== 挂载方式开关 ===== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 网络层（主开关） -->
                <LinearLayout style="@style/SettingRow">
                    <ImageView
                        style="@style/SettingRowIcon"
                        android:src="@drawable/ic_public"
                        app:tint="?attr/colorPrimary"
                        android:importantForAccessibility="no" />
                    <LinearLayout style="@style/SettingRowText">
                        <TextView
                            style="@style/SettingRowTitle"
                            android:text="网络层改写（推荐）" />
                        <TextView
                            style="@style/SettingRowSubtitle"
                            android:text="hook okhttp 响应，改写车型能力位 —— 与 iOS Shadowrocket 方案同一组字段" />
                    </LinearLayout>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/sw_web"
                        style="@style/SettingRowSwitch" />
                </LinearLayout>

                <View style="@style/SettingDivider" />

                <!-- G1 -->
                <LinearLayout style="@style/SettingRow">
                    <ImageView
                        style="@style/SettingRowIcon"
                        android:src="@drawable/ic_public"
                        app:tint="?attr/colorOnSurfaceVariant"
                        android:importantForAccessibility="no" />
                    <LinearLayout style="@style/SettingRowText">
                        <TextView
                            style="@style/SettingRowTitle"
                            android:text="G1 · vehicleKinds = 2" />
                        <TextView
                            style="@style/SettingRowSubtitle"
                            android:text="「骑行分析」入口 + 极速" />
                    </LinearLayout>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/sw_g1"
                        style="@style/SettingRowSwitch" />
                </LinearLayout>

                <!-- G2 -->
                <LinearLayout style="@style/SettingRow">
                    <ImageView
                        style="@style/SettingRowIcon"
                        android:src="@drawable/ic_public"
                        app:tint="?attr/colorOnSurfaceVariant"
                        android:importantForAccessibility="no" />
                    <LinearLayout style="@style/SettingRowText">
                        <TextView
                            style="@style/SettingRowTitle"
                            android:text="G2 · cyclingEventStatisticFlag = true" />
                        <TextView
                            style="@style/SettingRowSubtitle"
                            android:text="急加速 / 急刹 / 压弯" />
                    </LinearLayout>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/sw_g2"
                        style="@style/SettingRowSwitch" />
                </LinearLayout>

                <View style="@style/SettingDivider" />

                <!-- 视图层兜底 -->
                <LinearLayout style="@style/SettingRow">
                    <ImageView
                        style="@style/SettingRowIcon"
                        android:src="@drawable/ic_visibility"
                        app:tint="?attr/colorOnSurfaceVariant"
                        android:importantForAccessibility="no" />
                    <LinearLayout style="@style/SettingRowText">
                        <TextView
                            style="@style/SettingRowTitle"
                            android:text="视图层强制显示（兜底）" />
                        <TextView
                            style="@style/SettingRowSubtitle"
                            android:text="旧方案：把控件沿祖先链点亮，网络层失效时才用" />
                    </LinearLayout>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/sw_view"
                        style="@style/SettingRowSwitch" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== 说明 ===== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout style="@style/SettingRow">
                    <ImageView
                        style="@style/SettingRowIcon"
                        android:src="@drawable/ic_info"
                        app:tint="?attr/colorOnSurfaceVariant"
                        android:importantForAccessibility="no" />
                    <LinearLayout style="@style/SettingRowText">
                        <TextView
                            style="@style/SettingRowTitle"
                            android:text="版本 · 目标应用" />
                        <TextView
                            android:id="@+id/tv_version"
                            style="@style/SettingRowSubtitle"
                            android:text="com.cfmoto（LSPosed 作用域需勾选）" />
                    </LinearLayout>
                </LinearLayout>

                <View style="@style/SettingDivider" />

                <LinearLayout style="@style/SettingRow">
                    <ImageView
                        style="@style/SettingRowIcon"
                        android:src="@drawable/ic_info"
                        app:tint="?attr/colorOnSurfaceVariant"
                        android:importantForAccessibility="no" />
                    <LinearLayout style="@style/SettingRowText">
                        <TextView
                            style="@style/SettingRowTitle"
                            android:text="应用改动" />
                        <TextView
                            style="@style/SettingRowSubtitle"
                            android:text="开关实时送达运行中的 ZEEHO App；改动后建议冷重启一次确认效果" />
                    </LinearLayout>
                </LinearLayout>

                <View style="@style/SettingDivider" />

                <LinearLayout style="@style/SettingRow">
                    <ImageView
                        style="@style/SettingRowIcon"
                        android:src="@drawable/ic_info"
                        app:tint="?attr/colorOnSurfaceVariant"
                        android:importantForAccessibility="no" />
                    <LinearLayout style="@style/SettingRowText">
                        <TextView
                            style="@style/SettingRowTitle"
                            android:text="数据说明" />
                        <TextView
                            style="@style/SettingRowSubtitle"
                            android:text="只改能力位，极速/加速/急刹/压弯数值均为服务端真值" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
