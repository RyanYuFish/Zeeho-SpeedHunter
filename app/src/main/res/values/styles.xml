<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Material You：Android 12+ 由 DynamicColors 按壁纸动态取色覆盖；
         以下是低版本 / 未生效时的静态兜底（玫瑰色调，与系统观感接近）。 -->
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#8C4A4E</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#FFDAD9</item>
        <item name="colorOnPrimaryContainer">#410002</item>
        <item name="colorSecondaryContainer">#FFDAD9</item>
        <item name="colorOnSecondaryContainer">#410002</item>
        <item name="colorSurface">#FFF8F7</item>
        <item name="colorOnSurface">#231919</item>
        <item name="colorOnSurfaceVariant">#857372</item>
        <item name="colorOutline">#D0C4C3</item>
        <!-- edge-to-edge：栏透明 + 窗口背景同色，避免栏位黑边 -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">?attr/colorSurface</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <!-- ===== 设置行通用样式（SukiSU 式 icon + 标题/副标题 + 右侧开关） ===== -->
    <style name="SettingRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <style name="SettingRowIcon">
        <item name="android:layout_width">22dp</item>
        <item name="android:layout_height">22dp</item>
        <item name="android:layout_marginTop">2dp</item>
    </style>

    <style name="SettingRowText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">14dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="SettingRowTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="SettingRowSubtitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textAppearance">?attr/textAppearanceBodySmall</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="SettingRowSwitch">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="SettingDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">54dp</item>
        <item name="android:layout_marginEnd">18dp</item>
        <item name="android:background">?attr/colorOutline</item>
        <item name="android:alpha">0.4</item>
    </style>
</resources>
