<?xml version="1.0" encoding="utf-8"?>
<!--
  日志区底色：刻意比页面底色深一档（#EFE7E7 vs 页面 #FFF8F7），
  纯白底 + 11sp 深灰字在这台 ROM 上几乎看不出边界，
  而日志是「要看清内容」的地方，底色必须能界定范围。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="#EFE7E7" />
    <corners android:radius="18dp" />
</shape>
