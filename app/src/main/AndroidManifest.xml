<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- P2P 建连（Wi-Fi Direct）所需；前两个是 normal 级权限，安装即授予 -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!--
      ★★★ 连车机 AP 走 ConnectivityManager.requestNetwork()（WifiNetworkSpecifier），
        框架层要求 CHANGE_NETWORK_STATE，否则 requestNetwork 直接抛 SecurityException，
        「连接车辆 / 一键 OTA」会静默崩。该权限是 normal 级，安装即授予，但清单必须声明。
    -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
      ★★★ WRITE_SETTINGS（修改系统设置）：
        OtaP2p 用 WifiManager.setWifiEnabled() 开关 Wi-Fi，该方法在 API 29+ 必须持有
        WRITE_SETTINGS 否则抛 SecurityException；且它是 special 级权限，不能普通弹窗申请，
        必须由用户去系统设置页授予（ACTION_MANAGE_WRITE_SETTINGS）。声明 + 运行时引导缺一不可。
    -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <!--
      ★ mDNS 发现车机 `_EasyConn._tcp.local.`（2026-10-05）。
        没有 CHANGE_WIFI_MULTICAST_STATE 时，NsdManager 收不到组播响应，
        discoverServices 会静默回调 onDiscoveryStarted 却永不出 onServiceFound。
        该权限自 API 12 起不再需要用户手动授予，但清单里必须声明。
        运行时仍需 acquireMulticastLock()（见 OtaMdnsProbe）。
    -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!--
      ★ Android 14 (API 34) 起，声明foregroundServiceType="dataSync" 的前台服务
        必须同时有 FOREGROUND_SERVICE_DATA_SYNC，否则 startForeground() 直接抛异常。
        推送 106MB 需要前台服务保活，见 OtaPushService。
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!--
      ★★★ 必须声明 INTERNET，否则「最后一公里」整条链路都是静默失效的（2026-10-05 实测）：
        ① Socket.connect() 在无 INTERNET 权限的进程里抛 SecurityException ——
           OtaP2p.resolveAdbHost() 的 catch(Throwable) 会把它吞掉，于是**永远扫不到任何 5555**，
           日志只会打「候选 … 里都没有 5555 开着」，看不出是权限问题；
        ② NetworkInterface.getNetworkInterfaces() 只返回 loopback ——
           读不到 p2p0，判不出「组已成型」、也算不出 GO 网段。
      P2P + ADB 推包本质上就是网络操作，这个权限是必需的，不是可选项。
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!--
      ★★★ Android 13 (API 33) 起 Wi-Fi P2P 归到「附近设备」权限族：缺这一条时
      WifiP2pManager.discoverPeers / requestPeers 会被框架**直接拒绝**，
      回调 onFailure(reason=0) = P2P_UNSUPPORTED，且 requestPeers 秒回**空列表**。
      症状与「supplicant 卡死」一模一样（见 docs/35 §4），极易误判。
      运行时权限（dangerous），必须由用户在系统设置里授予 —— 应用启动时自检并提示。
    -->
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />
    <!--
      ★★ 读固件包（2026-10-06 车边实测）：Android 11+ 起 `Download/` 下的 zip 属于
      **非媒体文件**，用文件路径 `new FileInputStream("/sdcard/Download/x.zip")` 直读会抛
      `EACCES (Permission denied)` —— 即使已经在设置里给了「媒体/图片」权限也没用，
      READ_MEDIA_* 只覆盖图片/视频/音频。
      两条出路，本 App 都留了：
        ① SAF（ACTION_OPEN_DOCUMENT）选包 —— 免任何权限，见 OtaActivity 「选包…」；
        ② MANAGE_EXTERNAL_STORAGE「所有文件访问」—— 声明后由用户在系统
           特殊权限页授予，授予后原路径直读立刻可用。
    -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!--
      ★ 不再声明 SYSTEM_ALERT_WINDOW：日志悬浮窗已删（2026-10-04）。
      日志现在显示在 OTA 操作台页内，平白多要一个悬浮窗授权页不值得。
    -->
    <!-- 推包时用 socket 主动外连，不需要 INTERNET；保留只为将来起本地 HTTP 服务 -->

    <!-- 广播配置需要看见目标包（Android 11+ 包可见性） -->
    <queries>
        <package android:name="com.cfmoto" />
    </queries>

    <application
        android:name=".ui.UiApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true">

        <meta-data
            android:name="xposedmodule"
            android:value="true" />

        <meta-data
            android:name="xposeddescription"
            android:value="@string/xposed_description" />

        <meta-data
            android:name="xposedminversion"
            android:value="93" />

        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />

        <!-- 模块设置界面（Material You） -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          ★ socket_l OTA 操作台（不依赖官方 App、不依赖 Xposed、不依赖 adb）。
            协议已通过固件交叉验证，见 docs/47。
            入口：模块主界面「OTA 推送」按钮，
            adb: am start -n com.github.zeehospeedhunter/.ui.OtaActivity
        -->
        <activity
            android:name=".ui.OtaActivity"
            android:exported="false"
            android:label="仪表 OTA 推送"
            android:theme="@style/AppTheme" />

        <!--
          ★ 仪表投屏（EasyConnect 镜像）单独入口：解析投屏二维码 → 加入车机 AP →
            经 hook 在 com.cfmoto 内拉起官方投屏；绕过官方 App 手动操作。
            adb: am start -n com.github.zeehospeedhunter/.ui.MirrorActivity
        -->
        <activity
            android:name=".ui.MirrorActivity"
            android:exported="false"
            android:label="仪表投屏"
            android:theme="@style/AppTheme" />

        <!--
          推送期间的前台服务：106MB / 约 26000 帧要跑一两分钟，
          进程被回收会导致车机侧「已收 != 总长」、文件停在半截且不可回退。
        -->
        <service
            android:name=".ota.OtaPushService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
          压弯标定页：运行时调压弯/急刹阈值，每项都带「调它会发生什么」说明。
          adb: am start -n com.github.zeehospeedhunter/.ui.TuneActivity
        -->
        <activity
            android:name=".ui.TuneActivity"
            android:exported="false"
            android:label="压弯标定"
            android:theme="@style/AppTheme" />

        <!-- 开关的跨进程读取通道：hook 进程（com.cfmoto）从这里 query -->
        <provider
            android:name=".core.ConfigProvider"
            android:authorities="com.github.zeehospeedhunter.settings"
            android:exported="true"
            android:grantUriPermissions="true" />
    </application>

</manifest>
